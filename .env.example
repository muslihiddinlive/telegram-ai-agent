BOT_TOKEN=
SUPERADMIN_ID=
WEBHOOK_URL=
DB_GROUP_ID=
PORT=8080

# Bot adminlari + superadmin uchun kunlik chatmode limiti (standart 100)
ADMIN_DAILY_LIMIT=100

# Bir nechta AI provayder kalitlari (vergul bilan ajratilgan, ko'p bo'lishi mumkin)
GROQ_API_KEYS=key1,key2,key3
OPENAI_API_KEYS=
ANTHROPIC_API_KEYS=
DEEPSEEK_API_KEYS=

ENCRYPTION_KEY=

# Userbot (IXTIYORIY, faqat o'qiydi) — ishlatilmaydigan alohida akkaunt tavsiya etiladi.
# Session: python gen_userbot_session.py  (boshqa userbot bilan bir xil session'ni ISHLATMANG)
USERBOT_API_ID=
USERBOT_API_HASH=
USERBOT_SESSION=
USERBOT_ACCESS=all
USERBOT_RATE_PER_HOUR=15

# Instagram (IXTIYORIY) — Business/Creator akkaunt, instagram_content_publish ruxsati.
# Bo'sh bo'lsa instagram_* tool'lar AI'ga umuman berilmaydi.
IG_USER_ID=
IG_ACCESS_TOKEN=
# GRAPH_API_VERSION=v25.0
# Superadmindan tashqari yana kimlar joylay olsin (vergul bilan Telegram ID); standart: faqat superadmin
# IG_ALLOWED_USER_IDS=
# Standart WEBHOOK_URL ishlatiladi; boshqa ommaviy domen kerak bo'lsa:
# IG_PUBLIC_BASE_URL=

# Instagram — HAR FOYDALANUVCHI O'Z akkauntini ulaydi (/instagram). IXTIYORIY.
# Meta App Dashboard > Instagram > "API setup with Instagram login" > "Business login settings" dagi qiymatlar
# (Facebook ilovasining App ID/Secret'i EMAS, aynan *Instagram* App ID va Instagram app secret):
# IG_APP_ID=
# IG_APP_SECRET=
# (Yoki env'siz: superadmin /panel -> 📸 Instagram ulash orqali kiriting — qayta deploy shart emas; panel env'dan ustun.)
# Meta'da kiritiladigan URL'lar (<domen> = IG_PUBLIC_BASE_URL yoki WEBHOOK_URL):
#   OAuth redirect URI : https://<domen>/ig/callback
#   Deauthorize URL    : https://<domen>/ig/deauth
#   Data deletion URL  : https://<domen>/ig/data-deletion
#   Privacy policy URL : https://<domen>/ig/privacy
# IG_PRIVACY_CONTACT=      # maxfiylik sahifasida ko'rsatiladigan aloqa (standart: botdagi yordam bo'limi)
# Plus tarif chegaralari (Pro — cheksiz; bepul sinov — 3 kun, 1 marta):
# IG_PLUS_SCHEDULED=10     # kutayotgan rejalashtirilgan postlar
# IG_PLUS_TRIGGERS=3       # avtomatik qoidalar (kalit so'z -> DM)
# IG_PLUS_BANNED=10        # taqiqlangan so'zlar
# IG_PLUS_DM_DAILY=30      # DM'da AI: kuniga javoblar (akkaunt bo'yicha)

# Instagram izoh webhook'i (IXTIYORIY): spam izohni yashirish + kalit so'zga avtomatik DM.
# DIQQAT: Meta'da bitta ilovaga BITTA callback URL — agar weChat servisi hozir qabul qilayotgan bo'lsa,
# ikkalasini birdaniga yoqmang (DM ikki marta ketadi). Callback: https://<domen>/webhook/instagram
# IG_WEBHOOK_ENABLED=1
# META_APP_SECRET=
# WEBHOOK_VERIFY_TOKEN=
# IG_MAX_DMS_PER_HOUR=60
# Rejalashtirilgan post fayllari uchun papka (standart: data/ig_scheduled)
# IG_STORE_DIR=

# Instagram DM uchun AI yordamchi (IXTIYORIY; yuqoridagi webhook yoqilgan bo'lishi shart).
# Rejim va biznes ma'lumoti botdan boshqariladi: «IG DM yordamchisi holati», «shadow rejimni yoq».
# Meta'da webhook'da `messages` maydoniga ham obuna bo'ling.
# IG_AI_BOT_NAME=Gul do'koni yordamchisi
# IG_AI_MAX_PER_HOUR=100
# IG_AI_MAX_PER_USER_DAY=30
# IG_AI_HANDOFF_HOURS=12
# IG_AI_HUMAN_PAUSE_HOURS=24
# IG_AI_DISCLOSURE=

# GitHub: AI repo'ni o'zgartirishdan oldin zaxira ZIP foydalanuvchiga HAR DOIM, 1 bo'lsa bot egasiga (SUPERADMIN_ID) ham yuboriladi (foydalanuvchilarga ochiq aytiladi)
GITHUB_BACKUP_TO_ADMIN=1
# GitHub: bo'sh turgan vaqtinchalik ish nusxasi necha daqiqadan keyin diskdan o'chadi (klon = ZIP yuborish, diskda saqlanmaydi)
GITHUB_WORKSPACE_TTL_MIN=20
